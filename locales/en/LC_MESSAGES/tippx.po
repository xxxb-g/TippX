#: main.py:10
msgid "Ein Programm, um das deutsche Zehnfinger-Schreibsystem zu trainieren."
msgstr "A program for practicing the German touch typing system."

#: main.py:11
msgid "Debugging-Nachrichten zeigen"
msgstr "Show debugging messages"

#: main.py:12
msgid "aktiviere Dark Mode"
msgstr "Enable dark mode"

#: main.py:44
msgid "Bestätigung"
msgstr "Confirmation"

#: main.py:55 main.py:79
msgid "Ja"
msgstr "Yes"

#: main.py:56 main.py:78
msgid "Nein"
msgstr "No"

#: main.py:62 main.py:63
msgid "Folgender Fehler trat auf: "
msgstr "The following error occurred: "

#: main.py:93
msgid "Nicht unterstütztes Betriebssystem: "
msgstr "Unsupported operating system: "

#: main.py:114
msgid "neueste Version:"
msgstr "Latest version:"

#: main.py:115
msgid "Veröffentlicht am"
msgstr "Released on"

#: main.py:120
#, python-brace-format
msgid "Neuster offizieller Tag: {tag}. Du nutzt eine neuere Version."
msgstr "Latest official tag: {tag}. You are using a newer version."

#: main.py:156
msgid "Es ist ein Update verfügbar. Willst du es herunterladen?"
msgstr "An update is available. Do you want to download it?"

#: main.py:156
msgid "Update"
msgstr "Update"

#: main.py:214 main.py:267 main.py:268
msgid "(laut)"
msgstr "(loud)"

#: main.py:265 main.py:270
msgid "(stummgeschaltet)"
msgstr "(muted)"

#: main.py:272
msgid "TippX"
msgstr "TippX"

#: main.py:272
msgid "Willkommen zu TippX!"
msgstr "Welcome to TippX!"

#: main.py:272
msgid "Dies ist ein Trainer für das deutsche Zehnfinger-Schreibsystem."
msgstr "This is a trainer for the German touch typing system."

#: main.py:272
msgid "Am Anfang legst du ein Level und eine Zeit fest."
msgstr "At the beginning, you choose a level and a duration."

#: main.py:272
msgid ""
"Danach erscheinen Wortgruppen, die du so schnell und richtig wie möglich "
"abtippst."
msgstr ""
"Then groups of words appear, which you type as quickly and accurately as "
"possible."

#: main.py:272
msgid "Am Ende erscheint eine Auswertung."
msgstr "At the end, your results are displayed."

#: main.py:272
msgid "Du kannst mit:"
msgstr "You can use:"

#: main.py:272
msgid "- Escape: Abbrechen"
msgstr "- Escape: Cancel"

#: main.py:272
msgid "- D: Dark Mode umschalten (im Menü)"
msgstr "- D: Toggle dark mode (in the menu)"

#: main.py:272
#, python-brace-format
msgid "- M: Richtig-Geräusch stummschalten {mute}"
msgstr "- M: Mute the correct-answer sound {mute}"

#: main.py:272
msgid "- Enter: Eingabe bestätigen."
msgstr "- Enter: Confirm input."

#: main.py:272
msgid "Drücke Enter, um fortzufahren."
msgstr "Press Enter to continue."

#: main.py:303 main.py:347 main.py:348 main.py:421 main.py:422 main.py:424
#: main.py:425 main.py:427
msgid "Deine Eingabe: "
msgstr "Your input: "

#: main.py:305
msgid "ÜBERSICHT LEVEL:"
msgstr "LEVEL OVERVIEW:"

#: main.py:305
msgid "Jedes Level beinhaltet alle Zeichen aus allen vorherigen Level!"
msgstr "Each level includes all characters from all previous levels!"

#: main.py:305
msgid " 1: Grundstellung"
msgstr " 1: Home row"

#: main.py:305
msgid " 6: Shift Taste"
msgstr " 6: Shift key"

#: main.py:305
msgid "15: häufige Sonderzeichen"
msgstr "15: Common special characters"

#: main.py:305
msgid "16: Ziffern"
msgstr "16: Numbers"

#: main.py:305
msgid "17: Weitere Sonderzeichen"
msgstr "17: More special characters"

#: main.py:305
msgid "18: Alle Zeichen"
msgstr "18: All characters"

#: main.py:305
msgid "19: Ziffernblock 1 (Ziffern auf dem Ziffernblock)"
msgstr "19: Numpad 1 (numbers on the numpad)"

#: main.py:305
msgid "20: Ziffernblock 2 (Rechnen mit dem Ziffernblock)"
msgstr "20: Numpad 2 (calculations using the numpad)"

#: main.py:305
msgid "Welches Level möchtest du trainieren? "
msgstr "Which level would you like to practice? "

#: main.py:320
msgid "Wie viele Minuten lang möchtest du trainieren?"
msgstr "How many minutes would you like to practice for?"

#: main.py:432
msgid "Punkte: "
msgstr "Score: "

#: main.py:433
msgid "Fehler: "
msgstr "Errors: "

#: main.py:434
msgid "Länge: "
msgstr "Duration: "

#: main.py:434
msgid "Minuten"
msgstr "minutes"

#: main.py:435
msgid "Anschläge/Minute: "
msgstr "Keystrokes/minute: "

#: main.py:440
msgid "Drücke Enter, um nochmal zu spielen."
msgstr "Press Enter to play again."

#: main.py:440
msgid "Drücke Escape, um zu beenden."
msgstr "Press Escape to quit."

#: main.py:441
msgid "Auswertung"
msgstr "Results"

#: main.py:442
#, python-brace-format
msgid "Dein bisheriger Highscore: {score}"
msgstr "Your previous high score: {score}"

#: main.py:442
msgid "Das ist ein neuer Highscore!"
msgstr "That's a new high score!"
